      "title": "30 岁前的最后一年，究竟什么样才能做到 30 而立呢",
      "titleZh": "30 岁前的最后一年，究竟什么样才能做到 30 而立呢",
      "digestUrl": "https://wshyhlm1.github.io/forum-digest/stories/v2ex-1259559.html",
      "storyUrl": "https://wshyhlm1.github.io/forum-digest/stories/v2ex-1259559.html",
      "storyJsonUrl": "https://wshyhlm1.github.io/forum-digest/stories/v2ex-1259559.json",
      "hnUrl": "https://www.v2ex.com/t/1259559",
      "discussionUrl": "https://www.v2ex.com/t/1259559",
      "sourceUrl": "https://www.v2ex.com/t/1259559",
      "publishedAt": "2026-11-24T13:44:31.000Z",
