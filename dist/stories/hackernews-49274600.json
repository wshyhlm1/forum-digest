                  "textRawHtml": "It doesn't look right at all.",
                  "textZhHtml": "看起来根本不对。",
                  "translationStatus": "translated",
                  "contentHash": "2e572e6715f3ae8c4fcda39191a9eb15be757d84fdd69933ae950d82b90d3ff9",
                  "children": [
                    {
