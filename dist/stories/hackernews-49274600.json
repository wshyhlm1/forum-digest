            {
              "id": 49283296,
              "commentKey": "hackernews-49283296",
              "parentId": 49282521,
              "author": "pyaamb",
              "publishedAt": "2026-08-13T08:53:07.000Z",
              "level": 3,
              "hnUrl": "https://news.ycombinator.com/item?id=49283296",
              "sourceUrl": "https://news.ycombinator.com/item?id=49283296",
              "textRawHtml": "I prefer the Browser OS test",
              "textZhHtml": "我更喜欢浏览器操作系统测试",
              "translationStatus": "translated",
              "contentHash": "18de8b3e13be4615bb2b2eb7fbd16294971faa42e41f7abbd7ccebb0dd33d70e",
