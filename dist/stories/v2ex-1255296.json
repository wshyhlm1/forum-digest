  "title": "FinalShell 开源了？类 FinalShell 的 SSH 客户端 —— FinallyShell",
  "titleZh": "FinalShell 开源了？类 FinalShell 的 SSH 客户端 —— FinallyShell",
  "url": "https://www.v2ex.com/t/1255296",
  "domain": "v2ex.com",
