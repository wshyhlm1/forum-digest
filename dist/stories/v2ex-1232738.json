  "title": "沉浸式翻译开源轻量替代 Duo Translator v2.1.0 发布",
  "titleZh": "沉浸式翻译开源轻量替代 Duo Translator v2.1.0 发布",
  "url": "https://www.v2ex.com/t/1232738",
  "domain": "v2ex.com",
