      "title": "Nvidia Reinstates Jensen Huang as CEO",
      "titleZh": "Nvidia Reinstates Jensen Huang as CEO",
      "url": "https://www.cnbc.com/2026/11/23/nvidia-jensen-huang-ceo.html",
      "hnUrl": "https://news.ycombinator.com/item?id=50611576",
